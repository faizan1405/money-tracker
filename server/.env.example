# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=4000

# MySQL on Hostinger (hPanel → Databases → MySQL). Use a dedicated user with access to one database only.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Exact frontend origin(s) allowed to call the API, comma-separated. No wildcards.
CORS_ORIGIN="https://your-frontend-domain.com"

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# Set to true when the frontend and API are on different sites (cookie needs SameSite=None; Secure).
CROSS_SITE_COOKIES=true

# Max statement upload size in MB (statement AI processing is not enabled yet).
UPLOAD_MAX_MB=10

# Reserved for a later phase — leave empty for now.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
