# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=4000

# MySQL on Hostinger (hPanel → Databases → MySQL). Use a dedicated user with access to one database only.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Exact frontend origin(s) allowed to call the API, comma-separated. No wildcards.
CORS_ORIGIN="https://your-frontend-domain.com"

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# Set to true when the frontend and API are on different sites (cookie needs SameSite=None; Secure).
CROSS_SITE_COOKIES=true

# Max statement upload size in MB.
UPLOAD_MAX_MB=10

# OpenRouter (server-only; never put this in the frontend). Leave empty to import statements without AI.
OPENROUTER_API_KEY=
# Economical model for categorisation, and a stronger one used only for low-confidence rows.
AI_MODEL_FAST=openai/gpt-4.1-mini
AI_MODEL_STRONG=openai/gpt-4.1
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
# Spending caps in US dollars.
AI_MAX_COST_PER_STATEMENT_USD=0.05
AI_DAILY_COST_LIMIT_USD=1
AI_MAX_ROWS_PER_STATEMENT=400
